// # oocgroup Root Anchor
//
// Logline: Top-level anchor uniting core, render, and ipc subsystems for oocgroup.
//
// Setup: Bridges cgroup v2 management engine for CLI and MCP consumption.
//
// Beats:
//   1. Re-export core cgroup scanner, calculator, and auditor.
//   2. Re-export visual theme and dashboard renderer subsystem.
//   3. Re-export Model Context Protocol (MCP) IPC subsystem.
//   4. Provide root system verification predicate.

import "core/anchor.oo";
import "render/anchor.oo";
import "ipc/anchor.oo";

pub fn verify_oocgroup_system(fs: &FsReadCap) -> Bool {
    let core_ok: Bool = verify_core_subsystem(fs);
    let render_ok: Bool = verify_render_subsystem();
    let ipc_ok: Bool = verify_ipc_subsystem();

    return core_ok && render_ok && ipc_ok;
}
